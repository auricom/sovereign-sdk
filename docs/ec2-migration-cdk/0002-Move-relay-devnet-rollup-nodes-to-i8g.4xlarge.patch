From bb1011a7a7b490ff5ae642afab15210456326123 Mon Sep 17 00:00:00 2001
From: auricom <27022259+auricom@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:11:56 +0100
Subject: [PATCH 2/2] Move relay devnet rollup nodes to i8g.4xlarge

Switch the devnet primary, secondary and backup launch templates to
i8g.4xlarge with the single-NVMe disk profiles and a /dev/sdg logs
volume. Running nodes are not touched; each node is then replaced one by
one following the migration runbook.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 deployments/relay/devnet/parameters.json | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/deployments/relay/devnet/parameters.json b/deployments/relay/devnet/parameters.json
index 5d81e1c..8ecd43e 100644
--- a/deployments/relay/devnet/parameters.json
+++ b/deployments/relay/devnet/parameters.json
@@ -29,7 +29,8 @@
         "DomainName": "relay-devnet.sovereign-labs.xyz",
         "UnlimitedDomainNames": "relay-devnet-integrations.sovereign-labs.xyz",
         "AnsibleBranch": "cdk-deployment-november-2026",
-        "AuroraEngineVersion": "17.9"
+        "AuroraEngineVersion": "17.9",
+        "RollupNodeInstanceType": "i8g.4xlarge"
     },
     "secrets": {
         "CelestiaGrpcAuthToken": {
-- 
